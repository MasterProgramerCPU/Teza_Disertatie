\@writefile{lof}{\contentsline {figure}{\numberline {8.1}{\ignorespaces Scalarea wall-time-ului median al solverului SIDARTHE in functie de orizontul $t_{\max }$, pentru cele trei limbaje. R prezinta o crestere aproape liniara cu $t_{\max }$ ($\sim $$130\times $ intre 90 si 10\,000 de pasi), dominata de inserarile rand-cu-rand in baza de date prin \texttt  {dbExecute()}; integrarea propriu-zisa cu \texttt  {deSolve::ode} este sub-secundara. Python ramane stabil ($4$--$8$~ms), iar Julia este mai rapid in regimul amortizat dupa compilarea JIT, atingand $6$~ms la $10\,000$ de pasi.}}{43}{figure.caption.46}\protected@file@percent }
\newlabel{fig:scaling_wall_time}{{8.1}{43}{Scalarea wall-time-ului median al solverului SIDARTHE in functie de orizontul $t_{\max }$, pentru cele trei limbaje. R prezinta o crestere aproape liniara cu $t_{\max }$ ($\sim $$130\times $ intre 90 si 10\,000 de pasi), dominata de inserarile rand-cu-rand in baza de date prin \texttt {dbExecute()}; integrarea propriu-zisa cu \texttt {deSolve::ode} este sub-secundara. Python ramane stabil ($4$--$8$~ms), iar Julia este mai rapid in regimul amortizat dupa compilarea JIT, atingand $6$~ms la $10\,000$ de pasi}{figure.caption.46}{}}
\newlabel{fig:scaling_wall_time@cref}{{[figure][1][8]8.1}{[1][43][]43}{}{}{}}
