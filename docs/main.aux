\@writefile{lot}{\contentsline {table}{\numberline {7.4}{\ignorespaces Calibrare SIR cross-regiune pe valul 1 al pandemiei COVID-19 ($15$~martie -- $15$~august 2020 antrenare, $16$~august -- $15$~septembrie 2020 test). In toate cele patru cazuri $\gamma $ este fixat la valoarea de literatura $1/14$ zile, iar $\beta $ este optimizat prin Nelder-Mead. Valorile $\hat  \beta $ si $\hat  {\mathcal  {R}}_0$ sunt comparabile direct intre tari, dar erorile absolute reflecta scarile diferite de populatie (column N) si de I$_0$.}}{38}{table.caption.37}\protected@file@percent }
\newlabel{tab:calibration_multiregion}{{7.4}{38}{Calibrare SIR cross-regiune pe valul 1 al pandemiei COVID-19 ($15$~martie -- $15$~august 2020 antrenare, $16$~august -- $15$~septembrie 2020 test). In toate cele patru cazuri $\gamma $ este fixat la valoarea de literatura $1/14$ zile, iar $\beta $ este optimizat prin Nelder-Mead. Valorile $\hat \beta $ si $\hat {\mathcal {R}}_0$ sunt comparabile direct intre tari, dar erorile absolute reflecta scarile diferite de populatie (column N) si de I$_0$}{table.caption.37}{}}
\newlabel{tab:calibration_multiregion@cref}{{[table][4][7]7.4}{[1][37][]38}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7.5}{\ignorespaces Costul software al calibrarii SIR (Romania, valul 1; fereastra de $154$ zile, restart-uri multiple Nelder--Mead pentru scenariile liber si constrans). Coloana \emph  {in-process} masoara direct costul procedurii din \texttt  {calibrate.py}; coloana \emph  {naiv (ca job-uri)} proiecteaza costul daca fiecare simulare candidata ar fi un job separat prin aplicatie, folosind latenta end-to-end masurata a unui job SIR real ($1047$~ms/job); coloana \emph  {recomandat} corespunde calibrarii intr-un singur job, cu o singura simulare finala scrisa in baza de date. Numarul de simulari candidate este numarul real de evaluari ale functiei obiectiv.}}{38}{table.caption.39}\protected@file@percent }
\newlabel{tab:calibration_cost}{{7.5}{38}{Costul software al calibrarii SIR (Romania, valul 1; fereastra de $154$ zile, restart-uri multiple Nelder--Mead pentru scenariile liber si constrans). Coloana \emph {in-process} masoara direct costul procedurii din \texttt {calibrate.py}; coloana \emph {naiv (ca job-uri)} proiecteaza costul daca fiecare simulare candidata ar fi un job separat prin aplicatie, folosind latenta end-to-end masurata a unui job SIR real ($1047$~ms/job); coloana \emph {recomandat} corespunde calibrarii intr-un singur job, cu o singura simulare finala scrisa in baza de date. Numarul de simulari candidate este numarul real de evaluari ale functiei obiectiv}{table.caption.39}{}}
\newlabel{tab:calibration_cost@cref}{{[table][5][7]7.5}{[1][37][]38}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces Calibrare SIR cu $\gamma = 1/14$ pe valul 1 al pandemiei COVID-19, in patru tari europene cu scari de populatie diferite (atenție la scarile $y$ distincte). Linia neagra este seria observata, linia rosie continua este fitul pe fereastra de antrenare ($15$ mar. -- $15$ aug. 2020), iar linia rosie intrerupta este prognoza pe luna urmatoare. Linia verticala marcheaza granita antrenare/test. Modelul reproduce calitativ valul 1 in toate cele patru cazuri; divergenta pe test este vizibila in Spania, unde valul 2 incepe sa creasca rapid in septembrie, evidentiind limitarea structurala a SIR cu coeficienti constanti.}}{38}{figure.caption.38}\protected@file@percent }
\newlabel{fig:calibration_multiregion}{{7.3}{38}{Calibrare SIR cu $\gamma = 1/14$ pe valul 1 al pandemiei COVID-19, in patru tari europene cu scari de populatie diferite (atenție la scarile $y$ distincte). Linia neagra este seria observata, linia rosie continua este fitul pe fereastra de antrenare ($15$ mar. -- $15$ aug. 2020), iar linia rosie intrerupta este prognoza pe luna urmatoare. Linia verticala marcheaza granita antrenare/test. Modelul reproduce calitativ valul 1 in toate cele patru cazuri; divergenta pe test este vizibila in Spania, unde valul 2 incepe sa creasca rapid in septembrie, evidentiind limitarea structurala a SIR cu coeficienti constanti}{figure.caption.38}{}}
\newlabel{fig:calibration_multiregion@cref}{{[figure][3][7]7.3}{[1][37][]38}{}{}{}}
