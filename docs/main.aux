\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces Calibrare SIR pe Romania, valul 1 din 2020. Linia neagra arata seria observata; cele doua scenarii produc fituri vizual aproape identice pe fereastra de antrenare (MAE $\approx 1\,600$ cazuri pentru ambele), dar prognoza pe luna urmatoare diverge (MAE $13\,031$ pentru fitul liber vs $16\,727$ pentru cel constrans). Parametrii estimati difera substantial, ilustrand identifiabilitatea practica slaba: aceleasi date sunt explicate aproape la fel de bine de combinatii $(\beta , \gamma )$ foarte diferite.}}{35}{figure.caption.34}\protected@file@percent }
\newlabel{fig:calibration_sir_fit}{{7.1}{35}{Calibrare SIR pe Romania, valul 1 din 2020. Linia neagra arata seria observata; cele doua scenarii produc fituri vizual aproape identice pe fereastra de antrenare (MAE $\approx 1\,600$ cazuri pentru ambele), dar prognoza pe luna urmatoare diverge (MAE $13\,031$ pentru fitul liber vs $16\,727$ pentru cel constrans). Parametrii estimati difera substantial, ilustrand identifiabilitatea practica slaba: aceleasi date sunt explicate aproape la fel de bine de combinatii $(\beta , \gamma )$ foarte diferite}{figure.caption.34}{}}
\newlabel{fig:calibration_sir_fit@cref}{{[figure][1][7]7.1}{[1][34][]35}{}{}{}}
