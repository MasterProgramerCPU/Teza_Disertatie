\@writefile{lof}{\contentsline {figure}{\numberline {6.1}{\ignorespaces Iesirile runner-ului LSTM dedicat pe seria de cazuri active din Romania (4 ani, 22 ian. 2020 -- 31 dec. 2023), cu antrenare pe primele $80\%$ din puncte si evaluare pe ultimele $20\%$. Predictiile o-zi-inainte ($\hat  {y}_t = f_\theta (y_{t-14:t-1})$) urmaresc seria observata atat pe fereastra de antrenare cat si pe cea de test, dar prognoza autoregresiva care reintroduce iesirile in fereastra (dincolo de ziua $1440$) tinde rapid catre zero --- o limitare cunoscuta a LSTM-urilor compacte fara mecanisme explicite pentru sezonalitate, asupra careia un strat ulterior cu informatie exogena (intervalul de raportare, calendarul scolar) ar putea ameliora.}}{30}{figure.caption.30}\protected@file@percent }
\newlabel{fig:lstm_trajectory}{{6.1}{30}{Iesirile runner-ului LSTM dedicat pe seria de cazuri active din Romania (4 ani, 22 ian. 2020 -- 31 dec. 2023), cu antrenare pe primele $80\%$ din puncte si evaluare pe ultimele $20\%$. Predictiile o-zi-inainte ($\hat {y}_t = f_\theta (y_{t-14:t-1})$) urmaresc seria observata atat pe fereastra de antrenare cat si pe cea de test, dar prognoza autoregresiva care reintroduce iesirile in fereastra (dincolo de ziua $1440$) tinde rapid catre zero --- o limitare cunoscuta a LSTM-urilor compacte fara mecanisme explicite pentru sezonalitate, asupra careia un strat ulterior cu informatie exogena (intervalul de raportare, calendarul scolar) ar putea ameliora}{figure.caption.30}{}}
\newlabel{fig:lstm_trajectory@cref}{{[figure][1][6]6.1}{[1][29][]30}{}{}{}}
